# Database
DATABASE_URL=postgresql+asyncpg://nesis:nesis@localhost:5432/nesis

# Vector store (pgvector for RAG)
PGVECTOR_URL=postgresql+psycopg://nesis:nesis@localhost:5432/nesis

# App
APP_ENV=development
APP_VERSION=0.2.0

# Google Gemini (get a key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL (docker-compose)
POSTGRES_USER=nesis
POSTGRES_PASSWORD=nesis
POSTGRES_DB=nesis

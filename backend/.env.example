# Banco de dados
DATABASE_URL=sqlite:///./nesis.db

# Vector store (pgvector para RAG)
PGVECTOR_URL=postgresql+psycopg://nesis:nesis@localhost:5432/nesis

# App
APP_ENV=development
APP_VERSION=0.2.0

# Google Gemini (obtenha em https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# PostgreSQL (docker-compose)
POSTGRES_USER=nesis
POSTGRES_PASSWORD=nesis
POSTGRES_DB=nesis
